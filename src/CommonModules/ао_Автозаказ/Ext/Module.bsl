#Область ПрограммныйИнтерфейс

// Параметры расчета по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * ДатаРасчета - Дата - остатки на конец этого дня, продажи - за дни анализа, заканчивая им.
//   * ДнейАнализа - Число - за сколько дней брать продажи для среднего расхода.
//   * Склады - Массив из СправочникСсылка.Склады - пустой: все склады с параметрами пополнения.
//
Функция НовыеПараметрыРасчета() Экспорт

	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ДатаРасчета", ТекущаяДатаСеанса());
	ПараметрыРасчета.Вставить("ДнейАнализа", ДнейАнализаПоУмолчанию());
	ПараметрыРасчета.Вставить("Склады", Новый Массив);
	Возврат ПараметрыРасчета;

КонецФункции

// Потребность в пополнении по складам с параметрами пополнения (регистр ао_ПараметрыПополнения).
//
// Метод «минимум-максимум»: товар заказывается, когда доступный запас (свободный остаток + в пути + в непроведенных
// заказах) опускается до точки заказа, и дозаказывается до целевого запаса:
//   средний расход = продано за дни анализа / дни анализа;
//   точка заказа = максимум(средний расход * страховой запас в днях, минимальный остаток);
//   целевой запас = максимум(средний расход * (страховой запас + заказывать на дней), минимальный остаток).
// Затем учитываются минимальная партия и кратность, а для пополнения со склада-источника - его свободный остаток.
//
// Параметры:
//  ПараметрыРасчета - см. НовыеПараметрыРасчета
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки по складу, номенклатуре и характеристике, см. НоваяТаблицаПотребности.
//
Функция РассчитатьПотребность(ПараметрыРасчета) Экспорт

	Если ПараметрыРасчета.ДнейАнализа <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Количество дней анализа продаж должно быть больше нуля'");
	КонецЕсли;

	Результаты = ДанныеДляРасчета(ПараметрыРасчета);
	ОстаткиИсточников = Результаты[Результаты.ВГраница()].Выгрузить();
	ОстаткиИсточников.Индексы.Добавить("Склад, Номенклатура, Характеристика");

	Потребность = НоваяТаблицаПотребности();
	Выборка = Результаты[Результаты.ВГраница() - 1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПотребности = Потребность.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПотребности, Выборка);
		РассчитатьСтроку(СтрокаПотребности, Выборка, ПараметрыРасчета.ДнейАнализа);
		Если ЗначениеЗаполнено(СтрокаПотребности.СкладИсточник) И СтрокаПотребности.КЗаказу > 0 Тогда
			ОграничитьОстаткомИсточника(СтрокаПотребности, Выборка.Кратность, ОстаткиИсточников);
		КонецЕсли;
	КонецЦикла;

	Возврат Потребность;

КонецФункции

// Создает непроведенные заказы по рассчитанной потребности: заказы поставщикам - по поставщику и складу,
// заказы на перемещение - по складу-источнику и складу-получателю. Строки без поставщика и источника пропускаются.
//
// Параметры:
//  Потребность - ТаблицаЗначений - результат РассчитатьПотребность (можно отредактированный, учитывается КЗаказу).
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ЗаказНаПеремещение
//
Функция СоздатьЗаказы(Потребность) Экспорт

	СтрокиЗакупок = Потребность.СкопироватьКолонки("Поставщик, Склад, Номенклатура, Характеристика, КЗаказу");
	СтрокиПеремещений = Потребность.СкопироватьКолонки("СкладИсточник, Склад, Номенклатура, Характеристика, КЗаказу");
	Для Каждого СтрокаПотребности Из Потребность Цикл
		Если СтрокаПотребности.КЗаказу <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПотребности.СкладИсточник) Тогда
			ЗаполнитьЗначенияСвойств(СтрокиПеремещений.Добавить(), СтрокаПотребности);
		ИначеЕсли ЗначениеЗаполнено(СтрокаПотребности.Поставщик) Тогда
			ЗаполнитьЗначенияСвойств(СтрокиЗакупок.Добавить(), СтрокаПотребности);
		Иначе
			Продолжить; // не указан ни поставщик, ни склад-источник
		КонецЕсли;
	КонецЦикла;

	Созданные = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Для Каждого Заказ Из СгруппироватьПо(СтрокиЗакупок, "Поставщик, Склад") Цикл
			Созданные.Добавить(СоздатьЗаказПоставщику(Заказ.Ключ, Заказ.Строки));
		КонецЦикла;
		Для Каждого Заказ Из СгруппироватьПо(СтрокиПеремещений, "СкладИсточник, Склад") Цикл
			Созданные.Добавить(СоздатьЗаказНаПеремещение(Заказ.Ключ, Заказ.Строки));
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Созданные;

КонецФункции

// Обработчик регламентного задания ао_Автозаказ: расчет по всем складам с параметрами и создание заказов.
// Повторный запуск не дублирует заказы: непроведенные заказы уже входят в доступный запас.
//
Процедура ВыполнитьАвтозаказ() Экспорт

	Потребность = РассчитатьПотребность(НовыеПараметрыРасчета());
	Созданные = СоздатьЗаказы(Потребность);
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Автозаказ'"), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru = 'Создано заказов: %1'"), Созданные.Количество()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДнейАнализаПоУмолчанию()

	Возврат 30;

КонецФункции

Функция НоваяТаблицаПотребности()

	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	Потребность = Новый ТаблицаЗначений;
	Потребность.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Потребность.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Потребность.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Потребность.Колонки.Добавить("Остаток", ТипЧисло);
	Потребность.Колонки.Добавить("ВПути", ТипЧисло);
	Потребность.Колонки.Добавить("ВЗаказах", ТипЧисло);
	Потребность.Колонки.Добавить("Продано", ТипЧисло);
	Потребность.Колонки.Добавить("СреднийРасход", ТипЧисло);
	Потребность.Колонки.Добавить("ТочкаЗаказа", ТипЧисло);
	Потребность.Колонки.Добавить("ЦелевойЗапас", ТипЧисло);
	Потребность.Колонки.Добавить("Потребность", ТипЧисло);
	Потребность.Колонки.Добавить("КЗаказу", ТипЧисло);
	Потребность.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	Потребность.Колонки.Добавить("СкладИсточник", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Потребность.Колонки.Добавить("Пояснение", Новый ОписаниеТипов("Строка"));
	Возврат Потребность;

КонецФункции

Функция ДанныеДляРасчета(ПараметрыРасчета)

	СекундВСутках = 86400;
	ДатаРасчета = ПараметрыРасчета.ДатаРасчета;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПараметров() + ТекстЗапросаДвижений() + ТекстЗапросаИтогов();
	Если ПараметрыРасчета.Склады.Количество() = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Параметры.Склад В (&Склады)", "ИСТИНА");
	КонецЕсли;
	Запрос.УстановитьПараметр("Склады", ПараметрыРасчета.Склады);
	Запрос.УстановитьПараметр("МоментОстатков", Новый Граница(КонецДня(ДатаРасчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоАнализа",
		НачалоДня(ДатаРасчета) - (ПараметрыРасчета.ДнейАнализа - 1) * СекундВСутках);
	Запрос.УстановитьПараметр("КонецАнализа", КонецДня(ДатаРасчета));

	Возврат Запрос.ВыполнитьПакет();

КонецФункции

// Параметры пополнения, ключи аналитики номенклатуры, заказы на перемещение и продажи - во временные таблицы.
//
// Возвращаемое значение:
//  Строка - часть пакета запросов.
Функция ТекстЗапросаПараметров()

	Возврат
	"ВЫБРАТЬ
	|	Параметры.Склад КАК Склад,
	|	Параметры.Номенклатура КАК Номенклатура,
	|	Параметры.СтраховойЗапасДней КАК СтраховойЗапасДней,
	|	Параметры.ЗапасНаДней КАК ЗапасНаДней,
	|	Параметры.МинимальныйОстаток КАК МинимальныйОстаток,
	|	Параметры.Кратность КАК Кратность,
	|	Параметры.МинимальнаяПартия КАК МинимальнаяПартия,
	|	Параметры.Поставщик КАК Поставщик,
	|	Параметры.СкладИсточник КАК СкладИсточник
	|ПОМЕСТИТЬ ВТПараметры
	|ИЗ
	|	РегистрСведений.ао_ПараметрыПополнения КАК Параметры
	|ГДЕ
	|	Параметры.Склад В (&Склады)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Склад,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ключи.Ссылка КАК Аналитика,
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТКлючиАналитики
	|ИЗ
	|	Справочник.КлючиАналитикиУчетаНоменклатуры КАК Ключи
	|ГДЕ
	|	Ключи.Номенклатура В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТПараметры.Номенклатура КАК Номенклатура
	|			ИЗ
	|				ВТПараметры КАК ВТПараметры)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Аналитика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыНаПеремещение.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
	|	ЗаказыНаПеремещение.Номенклатура КАК Номенклатура,
	|	ЗаказыНаПеремещение.Характеристика КАК Характеристика,
	|	ЗаказыНаПеремещение.КОформлениюОстаток КАК КОформлению
	|ПОМЕСТИТЬ ВТЗаказыНаПеремещение
	|ИЗ
	|	РегистрНакопления.ЗаказыНаПеремещение.Остатки(
	|			&МоментОстатков,
	|			Номенклатура В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВТПараметры.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТПараметры КАК ВТПараметры)) КАК ЗаказыНаПеремещение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.Склад КАК Склад,
	|	Продажи.АналитикаУчетаНоменклатуры КАК Аналитика,
	|	Продажи.КоличествоОборот КАК Количество
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			&НачалоАнализа,
	|			&КонецАнализа,
	|			,
	|			АналитикаУчетаНоменклатуры В
	|					(ВЫБРАТЬ
	|						ВТКлючиАналитики.Аналитика КАК Аналитика
	|					ИЗ
	|						ВТКлючиАналитики КАК ВТКлючиАналитики)
	|				И Склад В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ВТПараметры.Склад КАК Склад
	|					ИЗ
	|						ВТПараметры КАК ВТПараметры)) КАК Продажи
	|;
	|";

КонецФункции

// Остатки, товары в пути, непроведенные заказы и продажи в одной временной таблице.
//
// Возвращаемое значение:
//  Строка - часть пакета запросов.
Функция ТекстЗапросаДвижений()

	Возврат
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.ВНаличииОстаток - Остатки.КОтгрузкеОстаток КАК Остаток,
	|	0 КАК ВПути,
	|	0 КАК ВЗаказах,
	|	0 КАК Продано
	|ПОМЕСТИТЬ ВТДанные
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&МоментОстатков,
	|			(Склад, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТПараметры.Склад КАК Склад,
	|					ВТПараметры.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТПараметры КАК ВТПараметры)) КАК Остатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказыПоставщикам.Склад,
	|	ЗаказыПоставщикам.Номенклатура,
	|	ЗаказыПоставщикам.Характеристика,
	|	0,
	|	ЗаказыПоставщикам.КПоступлениюОстаток,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			&МоментОстатков,
	|			(Склад, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТПараметры.Склад КАК Склад,
	|					ВТПараметры.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТПараметры КАК ВТПараметры)) КАК ЗаказыПоставщикам
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказыНаПеремещениеДокументы.СкладПолучатель,
	|	ВТЗаказыНаПеремещение.Номенклатура,
	|	ВТЗаказыНаПеремещение.Характеристика,
	|	0,
	|	ВТЗаказыНаПеремещение.КОформлению,
	|	0,
	|	0
	|ИЗ
	|	ВТЗаказыНаПеремещение КАК ВТЗаказыНаПеремещение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ЗаказыНаПеремещениеДокументы
	|		ПО ВТЗаказыНаПеремещение.ЗаказНаПеремещение = ЗаказыНаПеремещениеДокументы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПараметры КАК ВТПараметры
	|		ПО (ЗаказыНаПеремещениеДокументы.СкладПолучатель = ВТПараметры.Склад)
	|			И ВТЗаказыНаПеремещение.Номенклатура = ВТПараметры.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказыПоставщикам.Склад,
	|	ТоварыЗаказов.Номенклатура,
	|	ТоварыЗаказов.Характеристика,
	|	0,
	|	0,
	|	ТоварыЗаказов.Количество,
	|	0
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ТоварыЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказыПоставщикам
	|		ПО ТоварыЗаказов.Ссылка = ЗаказыПоставщикам.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПараметры КАК ВТПараметры
	|		ПО (ЗаказыПоставщикам.Склад = ВТПараметры.Склад)
	|			И ТоварыЗаказов.Номенклатура = ВТПараметры.Номенклатура
	|ГДЕ
	|	НЕ ЗаказыПоставщикам.Проведен
	|	И НЕ ЗаказыПоставщикам.ПометкаУдаления
	|	И НЕ ТоварыЗаказов.Отменено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказыНаПеремещениеДокументы.СкладПолучатель,
	|	ТоварыЗаказов.Номенклатура,
	|	ТоварыЗаказов.Характеристика,
	|	0,
	|	0,
	|	ТоварыЗаказов.Количество,
	|	0
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ТоварыЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ЗаказыНаПеремещениеДокументы
	|		ПО ТоварыЗаказов.Ссылка = ЗаказыНаПеремещениеДокументы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПараметры КАК ВТПараметры
	|		ПО (ЗаказыНаПеремещениеДокументы.СкладПолучатель = ВТПараметры.Склад)
	|			И ТоварыЗаказов.Номенклатура = ВТПараметры.Номенклатура
	|ГДЕ
	|	НЕ ЗаказыНаПеремещениеДокументы.Проведен
	|	И НЕ ЗаказыНаПеремещениеДокументы.ПометкаУдаления
	|	И НЕ ТоварыЗаказов.Отменено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТПродажи.Склад,
	|	ВТКлючиАналитики.Номенклатура,
	|	ВТКлючиАналитики.Характеристика,
	|	0,
	|	0,
	|	0,
	|	ВТПродажи.Количество
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКлючиАналитики КАК ВТКлючиАналитики
	|		ПО ВТПродажи.Аналитика = ВТКлючиАналитики.Аналитика
	|;
	|";

КонецФункции

// Итог по складу, номенклатуре и характеристике (по порядку наименований) и свободные остатки складов-источников.
//
// Возвращаемое значение:
//  Строка - часть пакета запросов.
Функция ТекстЗапросаИтогов()

	Возврат
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПараметры.Склад КАК Склад,
	|	ВТПараметры.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ВТДанные.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	СУММА(ЕСТЬNULL(ВТДанные.Остаток, 0)) КАК Остаток,
	|	СУММА(ЕСТЬNULL(ВТДанные.ВПути, 0)) КАК ВПути,
	|	СУММА(ЕСТЬNULL(ВТДанные.ВЗаказах, 0)) КАК ВЗаказах,
	|	СУММА(ЕСТЬNULL(ВТДанные.Продано, 0)) КАК Продано,
	|	ВТПараметры.СтраховойЗапасДней КАК СтраховойЗапасДней,
	|	ВТПараметры.ЗапасНаДней КАК ЗапасНаДней,
	|	ВТПараметры.МинимальныйОстаток КАК МинимальныйОстаток,
	|	ВТПараметры.Кратность КАК Кратность,
	|	ВТПараметры.МинимальнаяПартия КАК МинимальнаяПартия,
	|	ВТПараметры.Поставщик КАК Поставщик,
	|	ВТПараметры.СкладИсточник КАК СкладИсточник,
	|	Склады.Наименование КАК СкладНаименование,
	|	Товары.Наименование КАК НоменклатураНаименование
	|ИЗ
	|	ВТПараметры КАК ВТПараметры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО ВТПараметры.Склад = Склады.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	|		ПО ВТПараметры.Номенклатура = Товары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДанные КАК ВТДанные
	|		ПО ВТПараметры.Склад = ВТДанные.Склад
	|			И ВТПараметры.Номенклатура = ВТДанные.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПараметры.Склад,
	|	ВТПараметры.Номенклатура,
	|	ЕСТЬNULL(ВТДанные.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)),
	|	ВТПараметры.СтраховойЗапасДней,
	|	ВТПараметры.ЗапасНаДней,
	|	ВТПараметры.МинимальныйОстаток,
	|	ВТПараметры.Кратность,
	|	ВТПараметры.МинимальнаяПартия,
	|	ВТПараметры.Поставщик,
	|	ВТПараметры.СкладИсточник,
	|	Склады.Наименование,
	|	Товары.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкладНаименование,
	|	НоменклатураНаименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(Остатки.ВНаличииОстаток - Остатки.КОтгрузкеОстаток) КАК Свободно
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&МоментОстатков,
	|			(Склад, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТПараметры.СкладИсточник КАК Склад,
	|					ВТПараметры.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТПараметры КАК ВТПараметры
	|				ГДЕ
	|					ВТПараметры.СкладИсточник <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Склад,
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика";

КонецФункции

Процедура РассчитатьСтроку(СтрокаПотребности, Параметры, ДнейАнализа)

	СтрокаПотребности.СреднийРасход = СтрокаПотребности.Продано / ДнейАнализа;
	СтрокаПотребности.ТочкаЗаказа = Макс(СтрокаПотребности.СреднийРасход * Параметры.СтраховойЗапасДней,
		Параметры.МинимальныйОстаток);
	СтрокаПотребности.ЦелевойЗапас = Макс(
		СтрокаПотребности.СреднийРасход * (Параметры.СтраховойЗапасДней + Параметры.ЗапасНаДней),
		Параметры.МинимальныйОстаток);

	Доступно = СтрокаПотребности.Остаток + СтрокаПотребности.ВПути + СтрокаПотребности.ВЗаказах;
	Если Доступно > СтрокаПотребности.ТочкаЗаказа Тогда
		СтрокаПотребности.Пояснение = НСтр("ru = 'Запас выше точки заказа'");
		Возврат;
	КонецЕсли;
	СтрокаПотребности.Потребность = Макс(СтрокаПотребности.ЦелевойЗапас - Доступно, 0);
	Если СтрокаПотребности.Потребность = 0 Тогда
		СтрокаПотребности.Пояснение = НСтр("ru = 'Нет продаж и минимального остатка'");
		Возврат;
	КонецЕсли;

	КЗаказу = Макс(СтрокаПотребности.Потребность, Параметры.МинимальнаяПартия);
	СтрокаПотребности.КЗаказу = ОкруглитьВверхДоКратного(КЗаказу, Параметры.Кратность);
	Если СтрокаПотребности.КЗаказу > СтрокаПотребности.Потребность Тогда
		СтрокаПотребности.Пояснение = НСтр("ru = 'Округлено до минимальной партии и кратности'");
	КонецЕсли;

КонецПроцедуры

Процедура ОграничитьОстаткомИсточника(СтрокаПотребности, Кратность, ОстаткиИсточников)

	Отбор = Новый Структура("Склад, Номенклатура, Характеристика", СтрокаПотребности.СкладИсточник,
		СтрокаПотребности.Номенклатура, СтрокаПотребности.Характеристика);
	НайденныеСтроки = ОстаткиИсточников.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Свободно = 0;
	Иначе
		Свободно = Макс(НайденныеСтроки[0].Свободно, 0);
	КонецЕсли;

	Если СтрокаПотребности.КЗаказу > Свободно Тогда
		СтрокаПотребности.КЗаказу = ОкруглитьВнизДоКратного(Свободно, Кратность);
		СтрокаПотребности.Пояснение = СтрШаблон(НСтр("ru = 'Ограничено свободным остатком склада %1'"),
			СтрокаПотребности.СкладИсточник);
	КонецЕсли;
	// Остаток источника распределяется по складам-получателям в порядке строк
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденныеСтроки[0].Свободно = Свободно - СтрокаПотребности.КЗаказу;
	КонецЕсли;

КонецПроцедуры

Функция ОкруглитьВверхДоКратного(Количество, Кратность)

	Если Кратность <= 0 Тогда
		Возврат Количество;
	КонецЕсли;
	Частное = Количество / Кратность;
	Если Частное = Цел(Частное) Тогда
		Возврат Количество;
	КонецЕсли;
	Возврат (Цел(Частное) + 1) * Кратность;

КонецФункции

Функция ОкруглитьВнизДоКратного(Количество, Кратность)

	Если Кратность <= 0 Тогда
		Возврат Количество;
	КонецЕсли;
	Возврат Цел(Количество / Кратность) * Кратность;

КонецФункции

// Группы строк таблицы по значениям колонок.
//
// Параметры:
//  Таблица - ТаблицаЗначений
//  Колонки - Строка - имена колонок группировки через запятую.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ключ - СтрокаТаблицыЗначений - значения колонок группировки.
//   * Строки - Массив из СтрокаТаблицыЗначений
//
Функция СгруппироватьПо(Таблица, Колонки)

	Ключи = Таблица.Скопировать(, Колонки);
	Ключи.Свернуть(Колонки);
	Группы = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Отбор = Новый Структура(Колонки);
		ЗаполнитьЗначенияСвойств(Отбор, Ключ);
		Группы.Добавить(Новый Структура("Ключ, Строки", Ключ, Таблица.НайтиСтроки(Отбор)));
	КонецЦикла;
	Возврат Группы;

КонецФункции

Функция СоздатьЗаказПоставщику(Ключ, Строки)

	Заказ = Документы.ЗаказПоставщику.СоздатьДокумент();
	Заказ.Дата = ТекущаяДатаСеанса();
	Заказ.Заполнить(Новый Структура("Партнер, Склад", Ключ.Поставщик, Ключ.Склад));
	Заказ.Партнер = Ключ.Поставщик;
	Заказ.Склад = Ключ.Склад;
	Заказ.Статус = Перечисления.СтатусыЗаказовПоставщикам.НеСогласован;
	Заказ.Комментарий = КомментарийАвтозаказа();
	Для Каждого СтрокаЗаказа Из Строки Цикл
		СтрокаТоваров = Заказ.Товары.Добавить();
		СтрокаТоваров.Номенклатура = СтрокаЗаказа.Номенклатура;
		СтрокаТоваров.Характеристика = СтрокаЗаказа.Характеристика;
		СтрокаТоваров.Количество = СтрокаЗаказа.КЗаказу;
		СтрокаТоваров.КоличествоУпаковок = СтрокаЗаказа.КЗаказу;
		СтрокаТоваров.Склад = Ключ.Склад;
	КонецЦикла;
	Заказ.Записать(РежимЗаписиДокумента.Запись);
	Возврат Заказ.Ссылка;

КонецФункции

Функция СоздатьЗаказНаПеремещение(Ключ, Строки)

	Заказ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	Заказ.Дата = ТекущаяДатаСеанса();
	Заказ.Заполнить(Новый Структура("СкладОтправитель, СкладПолучатель", Ключ.СкладИсточник, Ключ.Склад));
	Заказ.СкладОтправитель = Ключ.СкладИсточник;
	Заказ.СкладПолучатель = Ключ.Склад;
	Заказ.Комментарий = КомментарийАвтозаказа();
	Для Каждого СтрокаЗаказа Из Строки Цикл
		СтрокаТоваров = Заказ.Товары.Добавить();
		СтрокаТоваров.Номенклатура = СтрокаЗаказа.Номенклатура;
		СтрокаТоваров.Характеристика = СтрокаЗаказа.Характеристика;
		СтрокаТоваров.Количество = СтрокаЗаказа.КЗаказу;
		СтрокаТоваров.КоличествоУпаковок = СтрокаЗаказа.КЗаказу;
	КонецЦикла;
	Заказ.Записать(РежимЗаписиДокумента.Запись);
	Возврат Заказ.Ссылка;

КонецФункции

Функция КомментарийАвтозаказа()

	Возврат СтрШаблон(НСтр("ru = 'Создан автозаказом %1'"), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));

КонецФункции

