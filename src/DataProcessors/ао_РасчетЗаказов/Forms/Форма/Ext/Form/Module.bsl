#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПараметрыРасчета = ао_Автозаказ.НовыеПараметрыРасчета();
	ДатаРасчета = НачалоДня(ПараметрыРасчета.ДатаРасчета);
	ДнейАнализа = ПараметрыРасчета.ДнейАнализа;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСозданныеЗаказы

&НаКлиенте
Процедура СозданныеЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, СозданныеЗаказы.НайтиПоИдентификатору(ВыбраннаяСтрока).Заказ);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)

	Если ДнейАнализа = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите, за сколько дней анализировать продажи'"), ,
			"ДнейАнализа");
		Возврат;
	КонецЕсли;
	РассчитатьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказы(Команда)

	ЕстьЧтоЗаказать = Ложь;
	Для Каждого СтрокаПотребности Из Потребность Цикл
		Если СтрокаПотребности.КЗаказу > 0 Тогда
			ЕстьЧтоЗаказать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьЧтоЗаказать Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нечего заказывать: рассчитайте потребность или укажите количество к заказу'"));
		Возврат;
	КонецЕсли;

	Создано = СоздатьЗаказыНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Автозаказ'"), ,
		СтрШаблон(НСтр("ru = 'Создано заказов: %1. Они не проведены - проверьте и проведите.'"), Создано));

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыПополнения(Команда)

	ОткрытьФорму("РегистрСведений.ао_ПараметрыПополнения.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьНаСервере()

	ПараметрыРасчета = ао_Автозаказ.НовыеПараметрыРасчета();
	ПараметрыРасчета.ДатаРасчета = ДатаРасчета;
	ПараметрыРасчета.ДнейАнализа = ДнейАнализа;
	Если ЗначениеЗаполнено(Склад) Тогда
		ПараметрыРасчета.Склады.Добавить(Склад);
	КонецЕсли;
	Потребность.Загрузить(ао_Автозаказ.РассчитатьПотребность(ПараметрыРасчета));

КонецПроцедуры

&НаСервере
Функция СоздатьЗаказыНаСервере()

	Созданные = ао_Автозаказ.СоздатьЗаказы(Потребность.Выгрузить());
	Для Каждого Заказ Из Созданные Цикл
		СозданныеЗаказы.Добавить().Заказ = Заказ;
	КонецЦикла;
	// Созданные заказы уже входят в доступный запас - пересчет покажет, что заказывать больше нечего
	РассчитатьНаСервере();
	Возврат Созданные.Количество();

КонецФункции

#КонецОбласти
