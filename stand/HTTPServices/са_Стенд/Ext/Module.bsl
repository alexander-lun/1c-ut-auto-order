// Стенд для интеграционных тестов автозаказа. Не для рабочих баз: создает справочники и движения регистров
// в режиме загрузки данных (как при обмене), без проведения документов.
//
// Все имена в запросах (склады, товары, поставщик) дополняются суффиксом uid сценария,
// поэтому данные разных тестов не пересекаются.

#Область ОбработчикиСобытий

// POST /scenario - тестовые данные сценария.
// {"uid", "date": "ГГГГ-ММ-ДД", "warehouses": [имя], "items": [{"name", "characteristics": [имя]}],
//  "settings": [{"warehouse", "item", "safety", "days", "min_stock", "multiple", "min_lot",
//                "supplier": bool, "source"}],
//  "stock": [{"warehouse", "item", "characteristic", "qty", "reserved"}],
//  "sales": [{"warehouse", "item", "characteristic", "qty", "days_ago"}],
//  "supplier_orders": [{"warehouse", "item", "qty"}], "transfer_orders": [{"from", "to", "item", "qty"}],
//  "drafts": [{"warehouse", "item", "qty"}]}
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция СценарийPOST(Запрос)

	Попытка
		Данные = ПрочитатьТело(Запрос);
		НачатьТранзакцию();
		Попытка
			СоздатьСценарий(Данные);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		Возврат Ответ(200, Новый Структура("ok", Истина));
	Исключение
		Возврат ОтветОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// POST /calculate {"uid", "date", "days", "warehouses": [имя]} - результат ао_Автозаказ.РассчитатьПотребность.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция РасчетPOST(Запрос)

	Попытка
		Данные = ПрочитатьТело(Запрос);
		Потребность = Автозаказ().РассчитатьПотребность(ПараметрыРасчета(Данные));
		Возврат Ответ(200, Новый Структура("rows", СтрокиПотребности(Потребность)));
	Исключение
		Возврат ОтветОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// POST /orders {"uid", "date", "days", "warehouses": [имя]} - расчет и ао_Автозаказ.СоздатьЗаказы.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ЗаказыPOST(Запрос)

	Попытка
		Данные = ПрочитатьТело(Запрос);
		Потребность = Автозаказ().РассчитатьПотребность(ПараметрыРасчета(Данные));
		Созданные = Автозаказ().СоздатьЗаказы(Потребность);
		Заказы = Новый Массив;
		Для Каждого Заказ Из Созданные Цикл
			Заказы.Добавить(ОписаниеЗаказа(Заказ));
		КонецЦикла;
		Возврат Ответ(200, Новый Структура("orders", Заказы));
	Исключение
		Возврат ОтветОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Сценарий

Процедура СоздатьСценарий(Данные)

	Суффикс = " " + Данные["uid"];
	ДатаСценария = ДатаИзСтроки(Данные["date"]);
	Ссылки = Новый Структура;
	Ссылки.Вставить("Склады", Новый Соответствие);
	Ссылки.Вставить("Товары", Новый Соответствие);
	Ссылки.Вставить("Характеристики", Новый Соответствие);
	Ссылки.Вставить("Ключи", Новый Соответствие);

	Для Каждого Имя Из Данные["warehouses"] Цикл
		Ссылки.Склады.Вставить(Имя, СоздатьСклад(Имя + Суффикс));
	КонецЦикла;
	Для Каждого Товар Из Данные["items"] Цикл
		Номенклатура = СоздатьНоменклатуру(Товар["name"] + Суффикс);
		Ссылки.Товары.Вставить(Товар["name"], Номенклатура);
		Характеристики = Товар["characteristics"];
		Если Характеристики <> Неопределено Тогда
			Для Каждого ИмяХарактеристики Из Характеристики Цикл
				Ссылки.Характеристики.Вставить(Товар["name"] + "/" + ИмяХарактеристики,
					СоздатьХарактеристику(Номенклатура, ИмяХарактеристики));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Поставщик = СоздатьПоставщика("Поставщик" + Суффикс);

	ЗаписатьПараметры(Данные["settings"], Ссылки, Поставщик);
	ЗаписатьОстатки(ЗначениеИлиПустойМассив(Данные, "stock"), Ссылки, ДатаСценария - 40 * 86400);
	ЗаписатьПродажи(ЗначениеИлиПустойМассив(Данные, "sales"), Ссылки, ДатаСценария);
	ЗаписатьЗаказыПоставщикам(ЗначениеИлиПустойМассив(Данные, "supplier_orders"), Ссылки, Поставщик, ДатаСценария);
	ЗаписатьЗаказыНаПеремещение(ЗначениеИлиПустойМассив(Данные, "transfer_orders"), Ссылки, ДатаСценария);
	ЗаписатьЧерновики(ЗначениеИлиПустойМассив(Данные, "drafts"), Ссылки, Поставщик, ДатаСценария);

КонецПроцедуры

Функция СоздатьСклад(Наименование)

	Склад = Справочники.Склады.СоздатьЭлемент();
	Склад.Наименование = Наименование;
	Склад.ТипСклада = Перечисления.ТипыСкладов.ОптовыйСклад;
	Склад.ОбменДанными.Загрузка = Истина;
	Склад.Записать();
	Возврат Склад.Ссылка;

КонецФункции

Функция СоздатьНоменклатуру(Наименование)

	Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
	Номенклатура.Наименование = Наименование;
	Номенклатура.НаименованиеПолное = Наименование;
	Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	Номенклатура.ОбменДанными.Загрузка = Истина;
	Номенклатура.Записать();
	Возврат Номенклатура.Ссылка;

КонецФункции

Функция СоздатьХарактеристику(Номенклатура, Наименование)

	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Номенклатура;
	Характеристика.Наименование = Наименование;
	Характеристика.ОбменДанными.Загрузка = Истина;
	Характеристика.Записать();
	Возврат Характеристика.Ссылка;

КонецФункции

Функция СоздатьПоставщика(Наименование)

	Партнер = Справочники.Партнеры.СоздатьЭлемент();
	Партнер.Наименование = Наименование;
	Партнер.НаименованиеПолное = Наименование;
	Партнер.Поставщик = Истина;
	Партнер.ОбменДанными.Загрузка = Истина;
	Партнер.Записать();
	Возврат Партнер.Ссылка;

КонецФункции

Функция КлючАналитики(Ссылки, Номенклатура, Характеристика, Склад)

	ИмяКлюча = СтрШаблон("%1/%2/%3", Номенклатура.УникальныйИдентификатор(),
		Характеристика.УникальныйИдентификатор(), Склад.УникальныйИдентификатор());
	Ключ = Ссылки.Ключи.Получить(ИмяКлюча);
	Если Ключ = Неопределено Тогда
		НовыйКлюч = Справочники.КлючиАналитикиУчетаНоменклатуры.СоздатьЭлемент();
		НовыйКлюч.Наименование = СтрШаблон("%1; %2", Номенклатура, Склад);
		НовыйКлюч.Номенклатура = Номенклатура;
		НовыйКлюч.Характеристика = Характеристика;
		НовыйКлюч.СкладскаяТерритория = Склад;
		НовыйКлюч.ОбменДанными.Загрузка = Истина;
		НовыйКлюч.Записать();
		Ключ = НовыйКлюч.Ссылка;
		Ссылки.Ключи.Вставить(ИмяКлюча, Ключ);
	КонецЕсли;
	Возврат Ключ;

КонецФункции

Процедура ЗаписатьПараметры(Настройки, Ссылки, Поставщик)

	Для Каждого Настройка Из Настройки Цикл
		Запись = РегистрыСведений.ао_ПараметрыПополнения.СоздатьМенеджерЗаписи();
		Запись.Склад = Ссылки.Склады[Настройка["warehouse"]];
		Запись.Номенклатура = Ссылки.Товары[Настройка["item"]];
		Запись.СтраховойЗапасДней = ЧислоИзДанных(Настройка, "safety");
		Запись.ЗапасНаДней = ЧислоИзДанных(Настройка, "days");
		Запись.МинимальныйОстаток = ЧислоИзДанных(Настройка, "min_stock");
		Запись.Кратность = ЧислоИзДанных(Настройка, "multiple");
		Запись.МинимальнаяПартия = ЧислоИзДанных(Настройка, "min_lot");
		Если Настройка["supplier"] = Истина Тогда
			Запись.Поставщик = Поставщик;
		КонецЕсли;
		Если Настройка["source"] <> Неопределено Тогда
			Запись.СкладИсточник = Ссылки.Склады[Настройка["source"]];
		КонецЕсли;
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьОстатки(Остатки, Ссылки, Дата)

	Если Остатки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Регистратор = ЗаписатьРегистратор(Документы.ПеремещениеТоваров.СоздатьДокумент(), Дата);
	Набор = РегистрыНакопления.ТоварыНаСкладах.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Для Каждого Остаток Из Остатки Цикл
		Движение = Набор.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Склад = Ссылки.Склады[Остаток["warehouse"]];
		Движение.Номенклатура = Ссылки.Товары[Остаток["item"]];
		Движение.Характеристика = Характеристика(Ссылки, Остаток);
		Движение.ВНаличии = Остаток["qty"];
		Движение.КОтгрузке = ЧислоИзДанных(Остаток, "reserved");
	КонецЦикла;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

КонецПроцедуры

Процедура ЗаписатьПродажи(Продажи, Ссылки, ДатаСценария)

	Для Каждого Продажа Из Продажи Цикл
		Дата = ДатаСценария - Продажа["days_ago"] * 86400 + 12 * 3600;
		Регистратор = ЗаписатьРегистратор(Документы.РеализацияТоваровУслуг.СоздатьДокумент(), Дата);
		Набор = РегистрыНакопления.ВыручкаИСебестоимостьПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Регистратор);
		Склад = Ссылки.Склады[Продажа["warehouse"]];
		Движение = Набор.Добавить();
		Движение.Период = Дата;
		Движение.АналитикаУчетаНоменклатуры = КлючАналитики(Ссылки, Ссылки.Товары[Продажа["item"]],
			Характеристика(Ссылки, Продажа), Склад);
		Движение.Склад = Склад;
		Движение.Количество = Продажа["qty"];
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьЗаказыПоставщикам(Заказы, Ссылки, Поставщик, Дата)

	Для Каждого Заказ Из Заказы Цикл
		Документ = Документы.ЗаказПоставщику.СоздатьДокумент();
		Документ.Партнер = Поставщик;
		Документ.Склад = Ссылки.Склады[Заказ["warehouse"]];
		Регистратор = ЗаписатьРегистратор(Документ, Дата);
		Набор = РегистрыНакопления.ЗаказыПоставщикам.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Регистратор);
		Движение = Набор.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.ЗаказПоставщику = Регистратор;
		Движение.Склад = Документ.Склад;
		Движение.Номенклатура = Ссылки.Товары[Заказ["item"]];
		Движение.КодСтроки = 1;
		Движение.Заказано = Заказ["qty"];
		Движение.КПоступлению = Заказ["qty"];
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьЗаказыНаПеремещение(Заказы, Ссылки, Дата)

	Для Каждого Заказ Из Заказы Цикл
		Документ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
		Документ.СкладОтправитель = Ссылки.Склады[Заказ["from"]];
		Документ.СкладПолучатель = Ссылки.Склады[Заказ["to"]];
		Регистратор = ЗаписатьРегистратор(Документ, Дата);
		Набор = РегистрыНакопления.ЗаказыНаПеремещение.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Регистратор);
		Движение = Набор.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.ЗаказНаПеремещение = Регистратор;
		Движение.Номенклатура = Ссылки.Товары[Заказ["item"]];
		Движение.КодСтроки = 1;
		Движение.Заказано = Заказ["qty"];
		Движение.КОформлению = Заказ["qty"];
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьЧерновики(Черновики, Ссылки, Поставщик, Дата)

	Для Каждого Черновик Из Черновики Цикл
		Документ = Документы.ЗаказПоставщику.СоздатьДокумент();
		Документ.Дата = Дата;
		Документ.Партнер = Поставщик;
		Документ.Склад = Ссылки.Склады[Черновик["warehouse"]];
		СтрокаТоваров = Документ.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Ссылки.Товары[Черновик["item"]];
		СтрокаТоваров.Количество = Черновик["qty"];
		СтрокаТоваров.КоличествоУпаковок = Черновик["qty"];
		Документ.ОбменДанными.Загрузка = Истина;
		Документ.Записать();
	КонецЦикла;

КонецПроцедуры

// Документ-регистратор без алгоритмов проведения: признак проведения ставится напрямую.
//
// Параметры:
//  Документ - ДокументОбъект
//  Дата - Дата
//
// Возвращаемое значение:
//  ДокументСсылка
//
Функция ЗаписатьРегистратор(Документ, Дата)

	Документ.Дата = Дата;
	Документ.Проведен = Истина;
	Документ.ОбменДанными.Загрузка = Истина;
	Документ.Записать();
	Возврат Документ.Ссылка;

КонецФункции

Функция Характеристика(Ссылки, Данные)

	Если Данные["characteristic"] = Неопределено Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Возврат Ссылки.Характеристики[Данные["item"] + "/" + Данные["characteristic"]];

КонецФункции

#КонецОбласти

#Область Расчет

// Модуль ао_Автозаказ из расширения АвтозаказТоваров: при проверке модулей стенда другое расширение не видно,
// поэтому модуль получается по имени.
//
// Возвращаемое значение:
//  ОбщийМодуль
//
Функция Автозаказ()

	Возврат ОбщегоНазначения.ОбщийМодуль("ао_Автозаказ");

КонецФункции

Функция ПараметрыРасчета(Данные)

	ПараметрыРасчета = Автозаказ().НовыеПараметрыРасчета();
	ПараметрыРасчета.ДатаРасчета = ДатаИзСтроки(Данные["date"]);
	Если Данные["days"] <> Неопределено Тогда
		ПараметрыРасчета.ДнейАнализа = Данные["days"];
	КонецЕсли;
	Для Каждого Имя Из Данные["warehouses"] Цикл
		Склад = Справочники.Склады.НайтиПоНаименованию(Имя + " " + Данные["uid"], Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			ВызватьИсключение СтрШаблон("Нет склада %1", Имя);
		КонецЕсли;
		ПараметрыРасчета.Склады.Добавить(Склад);
	КонецЦикла;
	Возврат ПараметрыРасчета;

КонецФункции

Функция СтрокиПотребности(Потребность)

	Строки = Новый Массив;
	Для Каждого СтрокаПотребности Из Потребность Цикл
		Данные = Новый Соответствие;
		Для Каждого Колонка Из Потребность.Колонки Цикл
			Значение = СтрокаПотребности[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Строка") Тогда
				Данные.Вставить(Колонка.Имя, Значение);
			Иначе
				Данные.Вставить(Колонка.Имя, Строка(Значение));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(Данные);
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция ОписаниеЗаказа(Заказ)

	Описание = Новый Структура;
	Описание.Вставить("type", Заказ.Метаданные().Имя);
	Описание.Вставить("posted", Заказ.Проведен);
	Описание.Вставить("comment", Заказ.Комментарий);
	Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Описание.Вставить("partner", Строка(Заказ.Партнер));
		Описание.Вставить("warehouse", Строка(Заказ.Склад));
		Описание.Вставить("status", Строка(Заказ.Статус));
	Иначе
		Описание.Вставить("from", Строка(Заказ.СкладОтправитель));
		Описание.Вставить("warehouse", Строка(Заказ.СкладПолучатель));
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого СтрокаТоваров Из Заказ.Товары Цикл
		Строки.Добавить(Новый Структура("item, characteristic, qty", Строка(СтрокаТоваров.Номенклатура),
			Строка(СтрокаТоваров.Характеристика), СтрокаТоваров.Количество));
	КонецЦикла;
	Описание.Вставить("lines", Строки);
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область HTTP

Функция ПрочитатьТело(Запрос)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Возврат ПрочитатьJSON(Чтение, Истина);

КонецФункции

Функция ДатаИзСтроки(Значение)

	Возврат XMLЗначение(Тип("Дата"), Значение + "T00:00:00");

КонецФункции

Функция ЧислоИзДанных(Данные, Имя)

	Значение = Данные[Имя];
	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

Функция ЗначениеИлиПустойМассив(Данные, Имя)

	Значение = Данные[Имя];
	Возврат ?(Значение = Неопределено, Новый Массив, Значение);

КонецФункции

Функция Ответ(Код, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(Информация)

	Возврат Ответ(500, Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация)));

КонецФункции

#КонецОбласти

#КонецОбласти
